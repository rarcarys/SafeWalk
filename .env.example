EXPO_PUBLIC_AUTH_API_URL=
# Optional: project ID for native push registration (no secrets here).
EXPO_PUBLIC_EAS_PROJECT_ID=
# Server-side options; never prefix secrets with EXPO_PUBLIC_.
# PostgreSQL URL stays on the API server. Empty means legacy SQLite.
DATABASE_URL=
# Optional directory with pg_dump/pg_restore for backups.
POSTGRES_BIN=
SAFEWALK_PUSH_ENABLED=0
EXPO_ACCESS_TOKEN=
