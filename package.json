{
  "name": "safewalk",
  "version": "1.0.0",
  "private": true,
  "description": "SafeWalk — карта, маршруты и контакты для сопровождения",
  "engines": {
    "node": ">=24"
  },
  "main": "index.js",
  "scripts": {
    "local": "node scripts/local.cjs --web",
    "doctor": "node scripts/local.cjs --check",
    "backup": "node scripts/backup.cjs",
    "db:setup": "node scripts/postgres-local.cjs",
    "db:migrate": "node scripts/migrate-postgres.cjs",
    "test:postgres": "node scripts/test-postgres.cjs",
    "https": "node scripts/https.cjs",
    "iphone": "node scripts/local.cjs --https --web",
    "android:build": "expo run:android --device",
    "start": "node scripts/local.cjs",
    "web": "node scripts/local.cjs --web",
    "android": "node scripts/local.cjs --android",
    "export": "expo export --platform all --clear",
    "api": "node server/auth.cjs",
    "test": "node --test server/*.test.cjs",
    "test:auth": "node --test server/auth.test.cjs",
    "test:maps": "node --test server/maps.test.cjs",
    "test:browser": "node --test scripts/*browser.test.cjs",
    "ios:build": "expo run:ios --device",
    "ios:build:unsigned": "npx --yes eas-cli@25.2.0 build --platform ios --profile ios-unsigned --non-interactive --no-wait"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "expo": "~57.0.26",
    "expo-battery": "~57.0.3",
    "expo-constants": "~57.0.20",
    "expo-font": "~57.0.4",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.20",
    "expo-location": "~57.0.20",
    "expo-notifications": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.21",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "leaflet": "^1.9.4",
    "pg": "^8.23.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
